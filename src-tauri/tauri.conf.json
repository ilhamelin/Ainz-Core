{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ainz Core Agent",
  "version": "0.1.1",
  "identifier": "com.benja.ainz-core",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ainz Core",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ilhamelin/Ainz-Core/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKIDY2OUNFQ0I1NzExRkM3NzUKUldSMXh4OXh0ZXljWnNDVm5TUC82ZEZrS1d3Rm82VS92MFUySXd1b0E2dkprbFNZcHBZaS9qaDkK",
      "dialog": true
    }
  },
  "bundle": {
    "publisher": "Meridian Core",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}